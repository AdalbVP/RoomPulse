# Copy this file to ".env" (same folder) and adjust the values.
# ".env" is ignored by git, so never put real secrets in THIS file.

# Matches the Postgres container from docker-compose.yml
DATABASE_URL="postgresql://postgres:password@localhost:5432/roompulse"

# Port the API listens on (default: 3000)
PORT=3000

# development | production | test (default: development)
NODE_ENV=development

# Browser origins allowed to call the API and open the socket, comma separated,
# WITHOUT a trailing slash. Required when NODE_ENV=production.
# If you leave it empty in development, any origin is allowed.
CORS_ORIGIN=http://localhost:5173
