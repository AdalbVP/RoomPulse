# Manual tests (VS Code "REST Client" extension)
# Run the backend first: npm run dev (inside apps/backend)
#
# Lifecycle enforced by the server:
#   PREPARING --(/status)--> LIGHT | TRAY | CART --(/complete)--> COMPLETED

@baseUrl = http://localhost:3000
# Paste real ids from the responses of requests 1 and 2
@ticketId = bef1782d-700b-4833-884c-8fdc3993f1f2
@freshTicketId = 94101a06-0e84-4e55-becc-8ffaf2f3bbe9

############################################################
# PART A - Validation and errors (sub-step 1)
############################################################

### 1. Create ticket  -> 201 + ticket JSON
POST {{baseUrl}}/tickets
Content-Type: application/json

{ "roomNumber": 101 }

### 2. Create a second ticket (stays in PREPARING)  -> 201
POST {{baseUrl}}/tickets
Content-Type: application/json

{ "roomNumber": 102 }

### 3. Missing field  -> 400 VALIDATION_ERROR
POST {{baseUrl}}/tickets
Content-Type: application/json

{}

### 4. roomNumber is text  -> 400 VALIDATION_ERROR
POST {{baseUrl}}/tickets
Content-Type: application/json

{ "roomNumber": "abc" }

### 5. roomNumber is a decimal  -> 400 VALIDATION_ERROR
POST {{baseUrl}}/tickets
Content-Type: application/json

{ "roomNumber": 101.5 }

### 6. roomNumber out of range  -> 400 VALIDATION_ERROR
POST {{baseUrl}}/tickets
Content-Type: application/json

{ "roomNumber": 10000 }

### 7. Broken JSON  -> 400 INVALID_JSON
POST {{baseUrl}}/tickets
Content-Type: application/json

{ "roomNumber": 101,

### 8. id is not a UUID  -> 400 VALIDATION_ERROR
PATCH {{baseUrl}}/tickets/not-a-uuid/status
Content-Type: application/json

{ "status": "LIGHT" }

### 9. Valid UUID that does not exist (/status)  -> 404 NOT_FOUND
PATCH {{baseUrl}}/tickets/11111111-1111-4111-8111-111111111111/status
Content-Type: application/json

{ "status": "LIGHT" }

### 10. Valid UUID that does not exist (/complete)  -> 404 NOT_FOUND
PATCH {{baseUrl}}/tickets/11111111-1111-4111-8111-111111111111/complete

### 11. Unknown route  -> 404 ROUTE_NOT_FOUND
GET {{baseUrl}}/nope

############################################################
# PART B - State machine (sub-step 2). Run in order, with ticketId.
############################################################

### 12. Skip the line: COMPLETED through /status  -> 400 VALIDATION_ERROR
PATCH {{baseUrl}}/tickets/{{ticketId}}/status
Content-Type: application/json

{ "status": "COMPLETED" }

### 13. Back to PREPARING through /status  -> 400 VALIDATION_ERROR
PATCH {{baseUrl}}/tickets/{{ticketId}}/status
Content-Type: application/json

{ "status": "PREPARING" }

### 14. Complete a ticket that was never delivered  -> 409 CONFLICT
PATCH {{baseUrl}}/tickets/{{freshTicketId}}/complete

### 15. Deliver the ticket (PREPARING -> LIGHT)  -> 200, deliveredAt is set (UI updates live)
PATCH {{baseUrl}}/tickets/{{ticketId}}/status
Content-Type: application/json

{ "status": "LIGHT" }

### 16. Change delivery type after delivering (LIGHT -> TRAY)  -> 409 CONFLICT
PATCH {{baseUrl}}/tickets/{{ticketId}}/status
Content-Type: application/json

{ "status": "TRAY" }

### 17. Complete the delivered ticket  -> 200, completedAt is set
PATCH {{baseUrl}}/tickets/{{ticketId}}/complete

### 18. Complete it again  -> 409 CONFLICT (completedAt must not change)
PATCH {{baseUrl}}/tickets/{{ticketId}}/complete

### 19. Deliver a completed ticket  -> 409 CONFLICT
PATCH {{baseUrl}}/tickets/{{ticketId}}/status
Content-Type: application/json

{ "status": "CART" }
